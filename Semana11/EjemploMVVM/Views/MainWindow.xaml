<Window x:Class="EjemploMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjemploMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="347*"/>
        </Grid.RowDefinitions>
        <Button x:Name="btnCargar" Content="Cargar Productos" Padding="5" Click="btnCargar_Click" />
        <DataGrid x:Name="dgProductos" Grid.Row="1" IsReadOnly="True"/>

    </Grid>
</Window>
