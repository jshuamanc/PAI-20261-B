<Window x:Class="EjemploMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjemploMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="347*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Buscar:" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBox Width="250" Margin="0,0,10,0" Text="{Binding textoBuscar}"/>
            <Button Content="Buscar Productos" Padding="5" Command="{Binding ComandoCargarProductos, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        
        <DataGrid Grid.Row="1" IsReadOnly="True" ItemsSource="{Binding productos}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80"/>
                <DataGridTextColumn Binding="{Binding nombre}" Header="Nombre Producto" Width="300"/>
                <DataGridTextColumn Binding="{Binding precio}" Header="Precio" Width="100"/>
                <DataGridTextColumn Binding="{Binding discontinuado}" Header="Discontinuado" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
