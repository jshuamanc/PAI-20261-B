<Window x:Class="EjemploMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjemploMVVM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="347*"/>
        </Grid.RowDefinitions>
        <Button Content="Cargar Productos" Padding="5" Command="{Binding ComandoCargarProductos, UpdateSourceTrigger=PropertyChanged}" />
        <DataGrid Grid.Row="1" IsReadOnly="True" ItemsSource="{Binding productos}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
