<Window x:Class="EjemploSQLCommandInsertar.AgregarCategoria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjemploSQLCommandInsertar"
        mc:Ignorable="d"
        Title="AgregarCategoria" Height="450" Width="800">
    <Grid Margin="30">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Nombre Categoria:" Width="120"/>
                <TextBox x:Name="txtNombre" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Descripción:" Width="120"/>
                <TextBox x:Name="txtDescripcion" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Button x:Name="btnRegistrar" Content="Agregar Categoria" Click="btnRegistrar_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
