<Window x:Class="EnlaceDatos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnlaceDatos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBox TextWrapping="Wrap" Text="{Binding Nombre}" FontSize="20" />
            <TextBlock TextWrapping="Wrap" Text="{Binding Nombre}" Margin="0,10,0,10" FontSize="15"/>
            <TextBox TextWrapping="Wrap" Text="{Binding Nombre, Mode=OneWay}"/>
            <TextBox TextWrapping="Wrap" Text="{Binding Precio, Mode=OneWayToSource}" />
            <Button x:Name="btnMostrar" Content="Mostrar" Click="btnMostrar_Click"/>
        </StackPanel>

    </Grid>
</Window>
