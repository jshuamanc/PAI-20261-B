<Window x:Class="Northwind.FrmProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Northwind"
        mc:Ignorable="d"
        Title="FrmProductos" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgProductos" AutoGenerateColumns="False" Grid.Row="0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ProductID}" Header="ID" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Binding="{Binding ProductName}" Header="Nombre" Width="*"/>
                <DataGridTextColumn Binding="{Binding UnitPrice}" Header="Precio Unitario" Width="100"/>
                <DataGridTextColumn Binding="{Binding UnitsInStock}" Header="Stock" Width="100"/>
                <DataGridCheckBoxColumn Binding="{Binding Discontinued}" Header="Discontinuado" Width="100"/>
            </DataGrid.Columns>
            
        </DataGrid>

        <StackPanel Grid.Row="1">
            <Button x:Name="btnGuardar" Content="Sincronizar Cambios" Background="#FF4F8438" Foreground="White" HorizontalAlignment="Right" FontSize="16" Padding="10,1,10,1" Margin="0,10,0,10" Click="btnGuardar_Click"/>

        </StackPanel>

    </Grid>
</Window>
