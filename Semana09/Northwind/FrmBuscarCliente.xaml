<Window x:Class="Northwind.FrmBuscarCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Northwind"
        mc:Ignorable="d"
        Title="FrmBuscarCliente" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock TextWrapping="Wrap" Text="Seleccionar País" FontWeight="Bold"/>
            <ComboBox x:Name="cbxPais" Width="200" Margin="11,0,0,0" SelectionChanged="cbxPais_SelectionChanged"/>
        </StackPanel>
        <ListView x:Name="lvClientes" Grid.Row="1" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding CustomerID}" Header="ID" Width="100"/>
                    <GridViewColumn DisplayMemberBinding="{Binding CompanyName}" Header="Nombre Compania" Width="200"/>
                    <GridViewColumn DisplayMemberBinding="{Binding ContactName}" Header="Nombre Contacto" Width="200"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Country}" Header="Pais" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
